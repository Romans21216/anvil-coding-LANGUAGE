# One line from each shipped library.

library import essentials
library import text
library import math
library import units
library import validate
library import geometry
library import vector

fn(main)
  say "-- essentials --"
  say call fn(gcd, 48, 18)
  say call fn(random-range, 1, 6, 12345)

  say "-- text --"
  say call fn(capitalize, "hello")
  say call fn(left-of, "key=value", "=")

  say "-- math --"
  say call fn(nth-prime, 10)
  say call fn(digits-sum, 12345)

  say "-- units --"
  say call fn(celsius-to-fahrenheit, 100)
  say call fn(km-to-miles, 10)

  say "-- validate --"
  say call fn(is-digit-text, "42")
  say call fn(is-digit-text, "4 2")

  say "-- geometry --"
  say call fn(area-triangle-sides, 3, 4, 5)
  say call fn(normalize-angle, -90)

  say "-- vector --"
  say call fn(length, 3, 4)
  say call fn(reflect-y, 1, 1, 0, 1)
end
call fn(main)
