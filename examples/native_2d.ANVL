# First graphical scene compiled directly by Anvil's x64/PE backend.
scene 2d
clear rgba(11, 16, 27, 255)
set var(panel-x) = 40
set var(offset) = 0
set var(paused) = 0
set var(pointer-x) = -1
set var(pointer-y) = -1

# Left drag positions the panel; wheel moves it horizontally.
# Right click pauses; middle click resets (keyboard controls also work).
fn(update)
  set var(pointer-x) = mouse_x()
  set var(pointer-y) = mouse_y()
  if mouse_held("left") and var(pointer-x) >= 0
    set var(panel-x) = var(pointer-x) - 250
  end
  add var(panel-x) mouse_wheel() * 30
  if mouse_pressed("right")
    set var(paused) = 1 - var(paused)
  end
  if mouse_pressed("middle")
    set var(panel-x) = 40
    set var(offset) = 0
  end
  if held(LEFT)
    sub var(panel-x) 180 * delta()
  end
  if held(RIGHT)
    add var(panel-x) 180 * delta()
  end
  if pressed(SPACE)
    set var(paused) = 1 - var(paused)
  end
  if pressed(R)
    set var(panel-x) = 40
    set var(offset) = 0
  end
  if var(paused) = 0
    add var(offset) compute(80 * delta())
  end
  if var(offset) > 440
    set var(offset) = 0
  end
end

fn(draw)
  display rect(var(panel-x), 40, 500, 260) -rgb(35, 60, 90)
  display rect(var(panel-x) + 24, 64, 180, 180) -rgb(88, 164, 255)
  display rect(var(panel-x) + 228, 64, 248, 72) -rgb(172, 106, 255)
  display rect(var(panel-x) + 228, 160, 248, 84) -rgb(93, 223, 199)
  display rect(var(panel-x) + var(offset), 276, 30, 8) -rgb(255, 210, 90)
  if var(pointer-x) >= 0
    display rect(var(pointer-x) - 3, var(pointer-y) - 3, 6, 6) -rgb(255, 255, 255)
  end
end
