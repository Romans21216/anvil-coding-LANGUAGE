language version 1
scene 3d
camera perspective 0 0 12
camera fov(70)
clear rgba(11, 16, 27, 255)

fn(draw)
  set var(previous_time) = model_animate("animated_morph.glb", time())
  set var(previous_weight) = model_morph("animated_morph.glb", 0, (sin(time()) + 1) / 2)
  set var(mesh_visible) = ray_mesh("animated_morph.glb", -1, -0.5, -1, 3, 0, 0, 0)
end
