# Tilemap demo: a 20x12 island drawn from the 4x4 tileset in assets/tiles.bmp.
# Each cell is 16x16 pixels in the sheet and drawn at 3x, so the map fills 960x576.
scene 2d
clear rgba(9, 12, 20, 255)
set var(sheet) = image_load("assets/tiles.bmp")
set var(map) = tilemap_new(var(sheet), 16, 16, 20, 12)

# Water everywhere, then paint the island as clipped rectangles. Tile 2 is
# water, 4 sand, 0 grass, 3 stone, 1 dirt, 5 brick, 6 wood.
set var(ok) = tilemap_fill(var(map), 16)
set var(ok) = tilemap_area(var(map), 4, 3, 2, 14, 8)
set var(ok) = tilemap_area(var(map), 0, 4, 3, 12, 6)
set var(ok) = tilemap_area(var(map), 3, 9, 3, 2, 5)
set var(ok) = tilemap_area(var(map), 1, 10, 2, 3, 2)
set var(ok) = tilemap_set(var(map), 6, 4, 6)
set var(ok) = tilemap_set(var(map), 12, 7, 5)
set var(ok) = tilemap_set(var(map), 13, 7, 5)
# Chamfer both layers at the corners so the island reads as an island.
set var(ok) = tilemap_set(var(map), 3, 2, 16)
set var(ok) = tilemap_set(var(map), 16, 2, 16)
set var(ok) = tilemap_set(var(map), 3, 9, 16)
set var(ok) = tilemap_set(var(map), 16, 9, 16)
set var(ok) = tilemap_set(var(map), 4, 3, 4)
set var(ok) = tilemap_set(var(map), 15, 3, 4)
set var(ok) = tilemap_set(var(map), 4, 8, 4)
set var(ok) = tilemap_set(var(map), 15, 8, 4)

# Water is tiles 16/17 in the animation strip; two frames at 0.8 fps.
set var(ok) = tilemap_animate(var(map), 16, 2, 0.8)

# Collision: the stone path is solid, water is not. Two probes are drawn at
# map-local coordinates (the map itself is drawn 24 px lower) and coloured by
# the query result.
set var(ok) = tilemap_solid(var(map), 3, 1)

fn(draw)
  display rect(0, 0, 960, 600) -rgba(9, 12, 20, 255)
  set var(drawn) = tilemap_draw(var(map), 0, 24, 3)
  set var(on_stone) = tilemap_collide(var(map), 432, 144, 18, 18, 3)
  set var(on_water) = tilemap_collide(var(map), 96, 432, 18, 18, 3)
  if var(on_stone) = 1
    display rect(432, 168, 18, 18) -rgba(214, 92, 82, 255)
  end
  if var(on_water) = 0
    display rect(96, 456, 18, 18) -rgba(96, 196, 128, 255)
  end
  display text("Anvil tilemap  20 x 12 cells  3x") -l(12, 4) -rgb(196, 210, 236)
end
