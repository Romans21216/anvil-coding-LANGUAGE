# Not reentrant: the accumulator is a global (locals hold numbers only).
fn(text-reverse, text)
  set var(text-reverse-acc) = ""
  set local(i) = len(var(text)) - 1
  while local(i) >= 0
    set var(text-reverse-acc) = var(text-reverse-acc) & mid(var(text), local(i), 1)
    set local(i) = local(i) - 1
  end
  output var(text-reverse-acc)
end
