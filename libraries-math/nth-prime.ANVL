fn(nth-prime, n)
  set local(want) = floor(var(n))
  if local(want) < 1
    output 0
  end
  if local(want) = 1
    output 2
  end
  # Even numbers above 2 are composite, so only odd candidates and odd
  # divisors are tried: half the divisions for the same answer.
  set local(found) = 1
  set local(candidate) = 3
  while local(found) < local(want)
    set local(prime) = 1
    set local(d) = 3
    while local(d) * local(d) <= local(candidate)
      if local(candidate) % local(d) = 0
        set local(prime) = 0
        set local(d) = local(candidate)
      end
      set local(d) = local(d) + 2
    end
    if local(prime) = 1
      set local(found) = local(found) + 1
      if local(found) = local(want)
        output local(candidate)
      end
    end
    set local(candidate) = local(candidate) + 2
  end
  output 0
end
