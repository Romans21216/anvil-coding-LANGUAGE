fn(center, text, width)
  set var(center-acc) = ""
  set var(center-acc) = var(center-acc) & var(text)
  while len(var(center-acc)) + 2 <= floor(var(width))
    set var(center-acc) = " " & var(center-acc) & " "
  end
  while len(var(center-acc)) < floor(var(width))
    set var(center-acc) = var(center-acc) & " "
  end
  output var(center-acc)
end
