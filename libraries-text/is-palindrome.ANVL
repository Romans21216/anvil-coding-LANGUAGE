fn(is-palindrome, text)
  set var(is-palindrome-acc) = ""
  set local(i) = len(var(text)) - 1
  while local(i) >= 0
    set var(is-palindrome-acc) = var(is-palindrome-acc) & mid(var(text), local(i), 1)
    set local(i) = local(i) - 1
  end
  if var(is-palindrome-acc) = var(text)
    output 1
  end
  output 0
end
